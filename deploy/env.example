# The server's environment: one KEY=value per line, comments on their own lines only
# (systemd's EnvironmentFile keeps `KEY=value # note` as part of the value). Install it as
# /etc/booking/env, root-owned, mode 0644: it holds no secret. Every variable is checked at
# startup; one out of bounds stops the server with every problem listed.
#
# Each line shows the default. A test (crates/booking-server/src/config.rs) keeps this
# file and the code in step: a variable added there must be added here.

# --- Listening and connection bounds (crates/booking-http/src/serve.rs) ---------------
# Loopback only: Caddy terminates TLS in front (deploy/Caddyfile).
# BOOKING_LISTEN=127.0.0.1:63550
# A request head must arrive within this; also the idle timeout of keep-alive connections.
# BOOKING_HEADER_READ_TIMEOUT_MS=10000
# Connections served at once; past it they wait in the listen backlog. Keep it below the
# unit's LimitNOFILE (deploy/booking.service) less the pool and some headroom.
# BOOKING_MAX_CONNECTIONS=512
# A response write that makes no progress for this long closes its connection.
# BOOKING_WRITE_STALL_MS=10000
# The answer to this many requests on one connection says Connection: close.
# BOOKING_MAX_REQUESTS_PER_CONNECTION=1000
# A connection older than this finishes its request in flight and closes.
# BOOKING_CONNECTION_MAX_AGE_MS=600000
# How long an aged connection may take to finish (at least the request timeout).
# BOOKING_REQUEST_GRACE_MS=10000
# How long shutdown waits for open connections; keep it below TimeoutStopSec.
# BOOKING_DRAIN_TIMEOUT_MS=15000

# --- Requests (crates/booking-http/src/stack.rs) --------------------------------------
# The whole request, body included; past it 503.
# BOOKING_REQUEST_TIMEOUT_MS=5000
# BOOKING_MAX_BODY_BYTES=65536
# /v1 requests running at once; past it 503 overloaded at once.
# BOOKING_MAX_IN_FLIGHT=64

# --- Scheduling bounds per caller (D-018) ------------------------------------------------
# Grid points (staff x days x points a day) one availability read may walk; past it 422.
# BOOKING_AVAILABILITY_MAX_CELLS=300000
# Availability computations at once, off the async workers; 0 is the CPU count.
# BOOKING_COMPUTE_PERMITS=0
# Per principal (member or token): availability reads and holds per second (429 past it),
# and unexpired holds per business (403 open_holds past it).
# BOOKING_READ_RATE_PER_SECOND=20
# BOOKING_HOLD_RATE_PER_SECOND=2
# BOOKING_OPEN_HOLDS_PER_PRINCIPAL=50

# --- Database (crates/booking-db) ------------------------------------------------------
# BOOKING_DB_MAX_CONNECTIONS=16
# BOOKING_DB_ACQUIRE_TIMEOUT_MS=2000
# BOOKING_DB_STATEMENT_TIMEOUT_MS=3000
# The /readyz probe's deadline.
# BOOKING_READY_TIMEOUT_MS=500
# How long startup waits for an unavailable database before giving up.
# BOOKING_STARTUP_TIMEOUT_MS=30000

# --- Health and logs -------------------------------------------------------------------
# /errorz answers 503 when server errors exceed this many per thousand requests over five
# minutes, once at least BOOKING_ERROR_MIN_REQUESTS were answered.
# BOOKING_ERROR_RATE_PERMILLE=50
# BOOKING_ERROR_MIN_REQUESTS=20
# BOOKING_LOG=info
# json for journald; text for a terminal.
# BOOKING_LOG_FORMAT=json

# --- Accounts (crates/booking-accounts) ------------------------------------------------
# A loopback SMTP relay (the local MTA that relays onward over TLS). Empty disables mail.
# BOOKING_SMTP_RELAY=
# BOOKING_MAIL_FROM=noreply@scheduling-deposits.invalid
# Where links in emails point.
# BOOKING_PUBLIC_URL=http://127.0.0.1:63550
# BOOKING_COOKIE_SECURE=true
# BOOKING_SESSION_TTL_S=604800
# BOOKING_SESSION_IDLE_S=86400
# Caddy on this host is 127.0.0.1: then budgets key on the client, not on Caddy.
# BOOKING_TRUSTED_PROXIES=
# BOOKING_PASSWORD_CONCURRENCY=2
# The free plan's limits (payments are bypassed).
# BOOKING_PLAN_MAX_MEMBERS=10
# BOOKING_PLAN_MAX_TOKENS=10
# BOOKING_PLAN_MAX_OWNED_WORKSPACES=3

# --- Secrets: never in this file ------------------------------------------------------
# The unit loads them as systemd credentials (LoadCredential=, files under
# /etc/booking/credentials, root:root 0600); the server reads $CREDENTIALS_DIRECTORY/<name>.
# Outside systemd, point a _FILE variable at an owner-only file instead:
#   database-url            the server, as the runtime role booking_app
#   migration-database-url  bookingctl migrate, digests, fingerprint, prune-events (booking_owner)
#   admin-database-url      bookingctl bootstrap only
#   owner-password          bookingctl bootstrap only
#   app-password            bookingctl bootstrap only
# BOOKING_DATABASE_URL_FILE=/etc/booking/credentials/database-url
# BOOKING_MIGRATION_DATABASE_URL_FILE=/etc/booking/credentials/migration-database-url
# BOOKING_ADMIN_DATABASE_URL_FILE=/etc/booking/credentials/admin-database-url
# BOOKING_OWNER_PASSWORD_FILE=/etc/booking/credentials/owner-password
# BOOKING_APP_PASSWORD_FILE=/etc/booking/credentials/app-password
